{
	"name": "vegetation",
	"version": "0.1.0",
	"description": "Procedural stylized trees, rocks and pebbles for three.js, with LODs, impostors, colliders and moss.",
	"keywords": [
		"three",
		"threejs",
		"three.js",
		"vegetation",
		"procedural",
		"tree",
		"rock",
		"lod",
		"impostor",
		"webgpu"
	],
	"license": "MIT",
	"author": "Akihiro Oyamada (https://github.com/yomotsu)",
	"homepage": "https://github.com/yomotsu/vegetation#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yomotsu/vegetation.git"
	},
	"bugs": {
		"url": "https://github.com/yomotsu/vegetation/issues"
	},
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./core": {
			"types": "./dist/core/index.d.ts",
			"import": "./dist/core/index.js"
		},
		"./webgpu": {
			"types": "./dist/webgpu/index.d.ts",
			"import": "./dist/webgpu/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"sideEffects": [
		"./dist/webgpu/index.js"
	],
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"build": "vite build && tsc -p tsconfig.build.json",
		"demo": "vite --config vite.demo.config.ts",
		"demo:webgpu": "vite --config vite.demo.config.ts --mode webgpu",
		"prepublishOnly": "npm run typecheck && npm run build"
	},
	"peerDependencies": {
		"three": ">=0.170.0"
	},
	"devDependencies": {
		"@types/three": "^0.186.0",
		"lil-gui": "^0.21.0",
		"three": "^0.186.1",
		"typescript": "^5.9.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
