{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"types": [ "vitest/globals", "vite/client" ]
	},
	"include": [ "src/**/*.ts", "tests/**/*.ts", "vite.config.ts" ]
}
