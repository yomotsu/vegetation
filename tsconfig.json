{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"baseUrl": ".",
		"paths": {
			"vegetation": [ "src/index.ts" ],
			"vegetation/webgpu": [ "src/webgpu/index.ts" ]
		},
		"types": [ "vitest/globals", "vite/client" ]
	},
	"include": [ "src/**/*.ts", "tests/**/*.ts", "demo/**/*.ts", "vite.config.ts", "vite.demo.config.ts" ]
}
